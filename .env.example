# ==============================================================================
# Hissaby Buddy - Root Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CONFIGURATION (Copy to backend/.env)
# ------------------------------------------------------------------------------
# Groq AI Cloud API Key (Get at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Pinecone Vector Database (Get at https://app.pinecone.io)
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here
PINECONE_INDEX_NAME=vectors

# Firebase Admin SDK (Path to your service account json key file)
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Networking & Ports
API_PORT=8000
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (Copy to frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_APP_TITLE=Hissaby Buddy | AI Financial Copilot
